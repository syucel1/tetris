# Browser console threshold: DEBUG, INFO (default), WARN, ERROR.
VITE_LOG_LEVEL=INFO

# Account database password. Applied when the tetris-db volume is first created; set it before
# the first `docker compose up` (changing it later also needs the password changed in PostgreSQL).
POSTGRES_PASSWORD=change-me

# Set to true when the site is served over HTTPS, so the session cookie is HTTPS-only.
COOKIE_SECURE=false
