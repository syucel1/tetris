{
  "name": "prism-tetris",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\" \"server/**/*.test.ts\"",
    "format": "prettier --write src server index.html tsconfig.json tsconfig.server.json",
    "format:check": "prettier --check src server index.html tsconfig.json tsconfig.server.json",
    "server": "node --experimental-strip-types --disable-warning=ExperimentalWarning server/src/index.ts",
    "server:admin": "node --experimental-strip-types --disable-warning=ExperimentalWarning server/src/cli.ts"
  },
  "dependencies": {
    "loglevel": "^1.9.2",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.3.3",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
